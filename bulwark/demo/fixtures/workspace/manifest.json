{
  "id": "workspace",
  "name": "Workspace board",
  "description": "Dense desktop app shell: nav, sidebar, metric cards, small table, actions.",
  "device": "desktop",
  "viewport": { "width": 800, "height": 600, "deviceScaleFactor": 1 },
  "flattenBackground": "#eef2f7",
  "routes": { "correct": "/workspace", "broken": "/workspace-broken" },
  "aliases": ["/complex", "/complex-broken"],
  "template": "workspace.html",
