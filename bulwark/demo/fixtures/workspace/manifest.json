  "seeds": [
    {
      "id": "heading-size",
      "cssClass": "defect-heading-size",
      "description": "Sprint board 18px instead of 22px",
      "expectedDefectTypes": ["font-size"]
    },
    {
      "id": "card-gap",
      "cssClass": "defect-card-gap",
      "description": "Metric cards spread farther apart",
      "expectedDefectTypes": ["position", "spacing"]
    },
    {
      "id": "nav-spacing",
      "cssClass": "defect-nav-spacing",
      "description": "Projects nav link shifted right",
      "expectedDefectTypes": ["position", "spacing"]
    },
    {
      "id": "primary-color",
      "cssClass": "defect-primary-color",
      "description": "Create task #3b82f6 instead of #2563eb",
      "expectedDefectTypes": ["color"]
    },
    {
      "id": "panel-shift",
      "cssClass": "defect-panel-shift",
      "description": "Table panel and actions shifted down 16px",
      "expectedDefectTypes": ["position", "spacing"]
    },
    {
      "id": "signin-font",
      "cssClass": "defect-signin-font",
