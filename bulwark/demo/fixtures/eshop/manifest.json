  "seeds": [
    {
      "id": "atc-color",
      "cssClass": "defect-atc-color",
      "description": "Add to cart #f97316 instead of #ea580c",
      "expectedDefectTypes": [
        "color"
      ]
    },
    {
      "id": "sale-badge",
