    { "id": "pie", "text": "", "role": "image" },
    { "id": "swatch-organic", "text": "", "role": "image" },
    { "id": "legend-organic", "text": "Organic", "role": "text" },
    { "id": "bars-title", "text": "Weekly revenue", "role": "heading" },
    { "id": "bars", "text": "", "role": "image" },
    { "id": "line-title", "text": "p95 latency", "role": "heading" },
    { "id": "line", "text": "", "role": "image" },
    { "id": "table-title", "text": "Top funnels", "role": "heading" }
