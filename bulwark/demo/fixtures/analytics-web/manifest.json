      "description": "Active users value ink #14b8a6 instead of #0f766e",
      "expectedDefectTypes": ["color"]
    },
    {
      "id": "export-color",
      "cssClass": "defect-export-color",
      "description": "Export CTA fill #14b8a6 instead of #0f766e",
      "expectedDefectTypes": ["color"]
    },
    {
      "id": "swatch-paid",
      "cssClass": "defect-swatch-paid",
