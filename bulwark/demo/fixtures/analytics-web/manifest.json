      "expectedDefectTypes": ["color"]
    },
    {
      "id": "up-ink",
      "cssClass": "defect-up-ink",
      "description": "Positive delta ink #34d399 instead of #047857",
      "expectedDefectTypes": ["color"]
    },
    {
      "id": "range-ink",
      "cssClass": "defect-range-ink",
      "description": "Range link #2dd4bf instead of #0f766e",
      "expectedDefectTypes": ["color"]
    },
    {
      "id": "pie-paid",
      "cssClass": "defect-pie-paid",
      "description": "Pie Paid series #fb923c instead of #ea580c",
      "expectedDefectTypes": ["color"]
    },
    {
      "id": "bar-series",
      "cssClass": "defect-bar-series",
