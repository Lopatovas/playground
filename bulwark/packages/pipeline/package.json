{
  "name": "@bulwark/pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bulwark application layer: configuration, measurement orchestration and report assembly",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run"
  },
  "dependencies": {
    "@bulwark/adapters": "workspace:*",
    "@bulwark/domain": "workspace:*",
    "@bulwark/imaging": "workspace:*",
    "@bulwark/ports": "workspace:*",
    "zod": "^3.24.1"
  }
}
