{
  "name": "@bulwark/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bulwark command line: capture, analyze, serve and diagnose",
  "bin": {
    "bulwark": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "start": "node ./dist/bin.js"
  },
  "dependencies": {
    "@bulwark/adapters": "workspace:*",
    "@bulwark/domain": "workspace:*",
    "@bulwark/imaging": "workspace:*",
    "@bulwark/pipeline": "workspace:*",
    "@bulwark/ports": "workspace:*",
    "commander": "^13.0.0",
    "playwright": "^1.49.0",
    "zod": "^3.25.76"
  }
}
