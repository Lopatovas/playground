# Local — docker compose up -d postgres
# Production — Render Postgres via render.yaml (DATABASE_URL wired automatically)
DATABASE_URL=postgresql://commitloop:commitloop@localhost:5432/commitloop

# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# Session secret (generate: openssl rand -hex 32)
SESSION_SECRET=

# API
API_PORT=3001
WEB_URL=http://localhost:3000

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Mentor access (comma-separated GitHub numeric user ids)
MENTOR_GITHUB_IDS=

# Optional
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_WAITLIST_URL=

# --- Production (commitloop.dev — set in Render / Vercel dashboards) ---
# WEB_URL=https://commitloop.dev
# GITHUB_CALLBACK_URL=https://api.commitloop.dev/auth/github/callback
# NEXT_PUBLIC_API_URL=https://api.commitloop.dev
