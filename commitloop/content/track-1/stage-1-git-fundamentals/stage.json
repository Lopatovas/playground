      {
        "id": "git-add",
        "prompt": "What does `git add` do?",
        "choices": [
          { "id": "a", "text": "Stages changes for the next commit" },
          { "id": "b", "text": "Pushes commits to GitHub" },
          { "id": "c", "text": "Creates a new branch" }
        ],
        "correctChoiceId": "a",
        "explanation": "`git add` updates the index. `git push` sends commits to the remote."
      },
      {
        "id": "meaningful-commit",
        "prompt": "Which is an acceptable daily commit on CommitLoop?",
        "choices": [
          { "id": "a", "text": "feat: add user registration form" },
          { "id": "b", "text": "update readme timestamp only" },
          { "id": "c", "text": "empty commit to keep streak" }
        ],
        "correctChoiceId": "a",
        "explanation": "Commits should describe real work: features, fixes, refactors, tests, or structure."
      },
      {
        "id": "git-log",
        "prompt": "What does `git log --oneline` show?",
        "choices": [
          { "id": "a", "text": "A compact history of commits" },
          { "id": "b", "text": "Uncommitted file changes" },
          { "id": "c", "text": "Remote branch list" }
        ],
        "correctChoiceId": "a",
        "explanation": "`git log` shows history. `git status` shows working tree changes."
      },
      {
        "id": "daily-rule",
        "prompt": "What is CommitLoop's minimum commit expectation on weekdays?",
