generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  company      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  entities     Entity[]
  feedback     Feedback[]

  @@map("users")
}

model Entity {
  id             String       @id @default(uuid())
  name           String
  normalizedName String
  domain         String?
  userId         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources     Source[]
  documents   Document[]
  signals     Signal[]
  competitors Competitor[]  @relation("CompanyCompetitors")
  competitorOf Competitor[] @relation("CompetitorEntity")

  @@unique([userId, normalizedName])
  @@map("entities")
}

model Competitor {
  id                String    @id @default(uuid())
  entityId          String
  competitorEntityId String
  muted             Boolean   @default(false)
  mutedAt           DateTime?
  createdAt         DateTime  @default(now())

  entity     Entity @relation("CompanyCompetitors", fields: [entityId], references: [id], onDelete: Cascade)
  competitor Entity @relation("CompetitorEntity", fields: [competitorEntityId], references: [id], onDelete: Cascade)

  @@unique([entityId, competitorEntityId])
  @@map("competitors")
}

enum SourceType {
  WEBSITE
  NEWS
  JOBS
  SOCIAL
  BLOG
}

enum DiscoveryMethod {
  SEARCH
  GRAPH_EXPANSION
  USER_SUGGESTION
}

model Source {
  id              String          @id @default(uuid())
  entityId        String
  type            SourceType
  url             String
  discoveryMethod DiscoveryMethod
  credibilityScore Float?
  signalDensity   Float?
  isActive        Boolean         @default(true)
  lastCheckedAt   DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  entity    Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([entityId, url])
  @@map("sources")
}

model Document {
  id        String   @id @default(uuid())
  sourceId  String
  entityId  String
  rawText   String
  url       String
  fetchedAt DateTime @default(now())
  processed Boolean  @default(false)

  source  Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  entity  Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  signals Signal[]

  @@map("documents")
}

enum SignalType {
  PRICING_CHANGE
  FEATURE_LAUNCH
  POSITIONING_CHANGE
  HIRING_SPIKE
}

model Signal {
  id         String     @id @default(uuid())
  entityId   String
  documentId String?
  type       SignalType
  summary    String
  confidence Float
  evidence   Json
  detectedAt DateTime   @default(now())

  entity   Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  document Document?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  feedback Feedback[]

  @@map("signals")
}

model Feedback {
  id        String   @id @default(uuid())
  signalId  String
  userId    String
  relevant  Boolean
  comment   String?
  createdAt DateTime @default(now())

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([signalId, userId])
  @@map("feedback")
}
