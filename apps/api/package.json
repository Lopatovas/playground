{
  "name": "@ai-readiness/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "dev": "node --loader ts-node/esm --watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:db:push": "prisma db push --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@ai-readiness/shared": "0.1.0",
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@bull-board/nestjs": "^7.1.5",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/swagger": "^11.4.4",
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.78.0",
    "csv-parse": "^6.2.1",
    "ioredis": "^5.11.0",
    "read-excel-file": "^9.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/multer": "^2.1.0",
    "@types/swagger-ui-express": "^4.1.8",
    "ts-node": "^10.9.2"
  }
}
